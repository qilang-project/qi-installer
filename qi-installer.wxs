<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v4 配置文件 - 生成 Windows MSI 安装包 -->
<!-- Version 占位 0.0.0 由 CI 在构建时替换为 MSI 合法版本（major≤255）。 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="奇语言编译器 Qi Compiler"
             Manufacturer="奇语言项目"
             Version="0.0.0"
             UpgradeCode="12345678-1234-1234-1234-123456789012"
             Language="2052"
             Codepage="65001"
             Scope="perMachine"
             Compressed="yes">

        <SummaryInformation Description="奇语言编译器安装程序"
                            Manufacturer="奇语言项目" />

        <MajorUpgrade DowngradeErrorMessage="已安装更新版本的奇语言编译器。" />
        <MediaTemplate EmbedCab="yes" />

        <!-- 功能定义 -->
        <Feature Id="ProductFeature" Title="奇语言编译器" Level="1"
                 Description="奇语言编译器核心组件">
            <ComponentGroupRef Id="ProductComponents" />
            <ComponentRef Id="EnvironmentPath" />
        </Feature>

        <!-- 安装到 Program Files\Qi\bin -->
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="Qi">
                <Directory Id="BinFolder" Name="bin" />
            </Directory>
        </StandardDirectory>

        <!-- 把 bin 目录加进系统 PATH -->
        <Component Id="EnvironmentPath" Directory="BinFolder"
                   Guid="87654321-4321-4321-4321-210987654321">
            <Environment Id="PATH" Name="PATH" Value="[BinFolder]"
                         Permanent="no" Part="last" Action="set" System="yes" />
        </Component>

        <Property Id="ARPURLINFOABOUT" Value="https://github.com/qilang-project" />
        <Property Id="ARPCONTACT" Value="support@qi-lang.org" />
    </Package>

    <!-- 要安装的文件：qi.exe（CI 解压 windows zip 后位于工作目录根） -->
    <Fragment>
        <ComponentGroup Id="ProductComponents" Directory="BinFolder">
            <Component Id="QiExecutable" Guid="11111111-1111-1111-1111-111111111111">
                <File Id="QiExe" Source="qi.exe" KeyPath="yes" Checksum="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>
</Wix>
